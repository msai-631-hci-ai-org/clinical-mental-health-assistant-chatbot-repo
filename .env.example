# Create a read-only token at https://huggingface.co/settings/tokens.
# Copy this file to .env and add the token after the equals sign. Never commit .env.
HF_TOKEN=

# All CMHA settings are optional. The defaults run locally on CPU.
CMHA_DATA_DIR=data
CMHA_INDEX_DIR=vector_db
CMHA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CMHA_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
CMHA_GENERATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct
CMHA_GENERATION_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
CMHA_DEVICE=-1
CMHA_TOP_K=3
CMHA_MIN_RELEVANCE_SCORE=0.25
CMHA_CHUNK_SIZE=700
CMHA_CHUNK_OVERLAP=100
CMHA_MAX_HISTORY_MESSAGES=4
